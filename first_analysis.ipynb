   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    " \n",
    "data = pd.DataFrame({\n",
    "    \"sample_id\": [1, 2, 3, 4, 5, 6],\n",
    "    \"group\": [\"control\"]*3 + [\"treatment\"]*3,\n",
    "    \"activity\": [90, 100, 110, 120, np.nan, 140],\n",
    "})\n",
    "summary = data.groupby(\"group\")[\"activity\"].agg([\"count\", \"mean\"])\n",
    "summary\n"
   ]
  }
